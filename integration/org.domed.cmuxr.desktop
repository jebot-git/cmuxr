[Desktop Entry]
Type=Application
Name=cmuxr
Comment=Console and Qt6 music player for DomeD
Exec=cmuxr --gui --open %U
TryExec=cmuxr
Icon=multimedia-player
Terminal=false
Categories=AudioVideo;Audio;Player;
MimeType=audio/mpeg;audio/flac;audio/x-flac;audio/ogg;application/ogg;audio/x-vorbis+ogg;audio/opus;audio/x-opus+ogg;audio/x-wav;audio/wav;audio/mp4;audio/x-m4a;audio/aac;audio/x-aac;
StartupWMClass=cmuxr
